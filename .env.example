# Supabase — from Project Settings > API in the Supabase dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Expo client (app/) — Expo only exposes vars prefixed with EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI service (api/) — server-side only, NEVER put this in the client
SUPABASE_SERVICE_ROLE_KEY=

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000
